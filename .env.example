# Specter / Mirror Mode - required API keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NVIDIA NIM Vision (Llama 4 Maverick)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_CHAT_COMPLETIONS_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_VISION_MODEL=meta/llama-4-maverick-17b-128e-instruct
VISION_PROVIDER=nvidia
VISION_FALLBACK_ENABLED=false
NVIDIA_VISION_TIMEOUT_MS=20000
NVIDIA_VISION_STREAM=false
NVIDIA_VISION_MAX_TOKENS=1200
NVIDIA_VISION_TEMPERATURE=0.1
NVIDIA_VISION_TOP_P=1
NVIDIA_VISION_FREQUENCY_PENALTY=0
NVIDIA_VISION_PRESENCE_PENALTY=0

# Optional: ElevenLabs for natural TTS (falls back to macOS 'say' if missing)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Optional: OpenAI for Whisper voice input (voice input disabled if missing)
OPENAI_API_KEY=your_openai_key_here

# Dev only: allow synthetic demo data in built app
# SPECTER_ENABLE_DEV_FALLBACK=true

# Debug
# DEBUG_VERBOSE=true
# VITE_DEBUG_VERBOSE=true

# GhostWiki Configuration
SPECTER_MODE=ghostwiki
MEMORY_SERVICE_PORT=8765
GHOSTWIKI_WIKI_ROOT=./demo-workflows/event-recap/wiki
COGNEE_ENABLED=false

# ── Ross: ClickHouse-backed GraphRAG retrieval ("Retr KG") ──────────────
# Leave CLICKHOUSE_HOST empty to disable Ross and keep local fallback search.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=true

# Embeddings provider: truefoundry | voyage | openai | local
EMBED_PROVIDER=truefoundry
EMBED_API_KEY=
# TrueFoundry: your workspace LLM-gateway base url + a hosted embedding model
EMBED_BASE_URL=
EMBED_MODEL=
# Voyage example:  EMBED_PROVIDER=voyage  EMBED_API_KEY=...  EMBED_MODEL=voyage-3
# Local example:   EMBED_PROVIDER=local   EMBED_MODEL=BAAI/bge-small-en-v1.5

# Clinical keyword gate for auto-execute replay (UCSF EHR vertical).
# Default true. Set false for general-purpose tutor demos so steps whose
# labels coincidentally match clinical verbs (e.g. "Sign Note") are not
# silently skipped.
CLINICAL_SAFETY_FILTER=true
